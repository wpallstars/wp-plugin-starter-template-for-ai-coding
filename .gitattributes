# Opt out of AI model training
* ai-training=false

# Keep development files out of release archives (git archive).
/.distignore       export-ignore
/.distignore-wporg export-ignore
/.wporg-links      export-ignore
/.gitattributes    export-ignore
/.gitignore        export-ignore
/.woodpecker.yml   export-ignore
/DEVELOPMENT.md    export-ignore
/RELEASING.md      export-ignore
/ROADMAP.md        export-ignore
/STABILITY.md      export-ignore
/TESTING.md        export-ignore
/docs              export-ignore
/scripts           export-ignore
/packages          export-ignore

# Built JavaScript and CSS (DEVELOPMENT.md → JavaScript builds): shipped, but
# made by the build, so GitHub folds them in diffs and language counts.
/assets/build/**   linguist-generated=true
