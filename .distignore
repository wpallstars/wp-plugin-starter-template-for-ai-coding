# Files excluded from the release builds (scripts/build-release.sh, wp dist-archive).
# The WordPress.org build also leaves out the files in .distignore-wporg, and
# replaces the affiliate links listed in .wporg-links.
.git
.gitattributes
.gitignore
.distignore
.distignore-wporg
.wporg-links
# WordPress.org SVN assets (banners) and their source; admin/images/banner.svg ships instead.
.wordpress-org
.woodpecker.yml
# Development tools and CI (composer.json lists development tools only).
.github
.editorconfig
.gitleaks.toml
.codacy.yml
sonar-project.properties
.aidevops.json
composer.json
composer.lock
phpcs.xml.dist
phpcs.xml
phpstan.neon.dist
phpstan.neon
phpstan-baseline.neon
phpstan-plugin.neon
/dist
.DS_Store
.aider*
# Local AI tooling state (aidevops), never part of the plugin.
.agents
.task-counter
.security-analysis
*.bak
.metadata_never_index
.syncing
AGENTS.md
CODE_OF_CONDUCT.md
CONTRIBUTING.md
DEVELOPMENT.md
LAUNCH.md
SECURITY.md
STANDARDS.md
RELEASING.md
ROADMAP.md
STABILITY.md
TESTING.md
DESIGN.md
# Agent and developer task docs (STANDARDS.md → Agent docs).
/docs
/scripts
reference-plugins
project-documents
node_modules
/vendor
# JavaScript build sources and tools; only the built files in assets/build/
# ship (DEVELOPMENT.md → JavaScript builds).
/packages
/package.json
/package-lock.json
/pnpm-lock.yaml
/pnpm-workspace.yaml
/tsconfig.json
/tsconfig.*.json
/webpack.config.js
/eslint.config.js
/eslint.config.mjs
/.npmrc
/.nvmrc
/.browserslistrc
