{
	"root": true,
	"env": {
		"browser": true,
		"es2022": true
	},
	"parserOptions": {
		"ecmaVersion": 2022,
		"sourceType": "script"
	},
	"globals": {
		"jQuery": "readonly",
		"wp": "readonly",
		"ajaxurl": "readonly"
	},
	"extends": ["eslint:recommended"],
	"overrides": [
		{
			"files": ["*.ts", "*.tsx"],
			"parser": "@typescript-eslint/parser",
			"parserOptions": {
				"sourceType": "module",
				"ecmaFeatures": {
					"jsx": true
				}
			},
			"plugins": ["@typescript-eslint"],
			"extends": ["plugin:@typescript-eslint/recommended"],
			"rules": {
				"no-undef": "off"
			}
		},
		{
			"files": ["*.config.js", "scripts/**/*.js"],
			"env": {
				"node": true,
				"browser": false
			}
		}
	]
}
